<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.marzuk</groupId>
    <artifactId>chat-app</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>

    <name>chat-app</name>
    <description>Real-time chat application — monorepo root aggregator</description>

    <!-- ================================================================
         Child modules — declared in dependency order.
         lib/* resolves before packages/* that depend on them.
         Each module independently inherits spring-boot-starter-parent.
    ================================================================ -->
    <modules>
        <!-- Shared libraries -->
        <module>lib/components</module>
        <module>lib/authorizer</module>
        <module>lib/rest-starter</module>
        <module>lib/web-starter</module>

        <!-- Services -->
        <module>packages/auth</module>
        <module>packages/user</module>
        <module>packages/chat</module>
        <module>packages/notification</module>
        <module>packages/storage</module>
        <module>packages/api-gateway</module>
        <module>packages/admin-portal</module>
    </modules>

    <!-- ================================================================
         Init executions — initialise the project before first run.
         Linux/Mac : mvn exec:exec@init -N
         Windows   : mvn exec:exec@init-win -N
    ================================================================ -->
    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <inherited>false</inherited>
                <configuration>
                    <java>
                        <includes>
                            <include>lib/**/src/main/java/**/*.java</include>
                            <include>lib/**/src/test/java/**/*.java</include>
                            <include>packages/**/src/main/java/**/*.java</include>
                            <include>packages/**/src/test/java/**/*.java</include>
                        </includes>
                        <googleJavaFormat>
                            <version>1.22.0</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>1.6.0</version>
                <inherited>false</inherited>
                <executions>
                    <!-- Linux / Mac -->
                    <execution>
                        <id>init</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${project.basedir}/infrastructure/bash/init_scripts/initialize.sh</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Windows -->
                    <execution>
                        <id>init-win</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/infrastructure/bash/init_scripts/initialize_win.bat</executable>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
