# JWT (generated by initialize.sh — do not edit manually)
JWT_PRIVATE_KEY=replace-with-base64-encoded-rsa-private-key
JWT_PUBLIC_KEY=replace-with-base64-encoded-rsa-public-key

# Spring
ACTIVE_PROFILES=compose,dev
JPA_DDL_AUTO=update

# PostgreSQL
POSTGRES_USER=replace-with-postgres-username
POSTGRES_PASSWORD=replace-with-postgres-password

# MinIO
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# Mail (Mailpit handles SMTP locally — no credentials needed)
MAIL_USERNAME=
MAIL_PASSWORD=
