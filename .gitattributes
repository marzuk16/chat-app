# Auto-detect text files and normalize line endings (LF on all platforms)
* text=auto eol=lf

# Java sources
*.java text eol=lf
*.kt text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Build wrappers
mvnw text eol=lf
gradlew text eol=lf
mvnw.cmd text eol=crlf
gradlew.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
